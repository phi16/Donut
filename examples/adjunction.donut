// Adjunction
//
// F ⊣ G の随伴を、unit/counit と
// triangle identity (zig-zag identity) で表現する。
//
// F: C → D, G: D → C に対して:
//   η (unit):   id_C → GF
//   ε (counit): FG → id_D
//
// Triangle identities (3-cell):
//   zig: (F·η)(ε·F) = id_F
//   zag: (η·G)(G·ε) = id_G

C D: *
F: C → D
G: D → C

// Unit and counit
η: C → F G
ε: G F → D

// Triangle identities
//
// zig:
//   F →[η F]→ F G F →[F ε]→ F
//   この合成が F 上の恒等射に等しい
//
// zag:
//   G →[G η]→ G F G →[ε G]→ G
//   この合成が G 上の恒等射に等しい

zig: η F; F ε ~ F
zag: G η; ε G ~ G

use "base"
use "ui"

C: *

[style.color[hue[0.3]]]
bool: C → C with {
    lit[n: nat]: C → bool
    not: bool → bool
    and: bool bool → bool
    or: bool bool → bool
    dup: bool → bool bool
    drop: bool → C
    swap: bool bool → bool bool
}

[style.color[hue[0.1]]]
f32: C → C with {
    lit[n: nat]: C → f32
    add: f32 f32 → f32
    sub: f32 f32 → f32
    mul: f32 f32 → f32
    div: f32 f32 → f32
    neg: f32 → f32
    dup: f32 → f32 f32
    drop: f32 → C
    swap: f32 f32 → f32 f32
}

[style.color[hue[0.6]]]
u32: C → C with {
    lit[n: nat]: C → u32
    add: u32 u32 → u32
    sub: u32 u32 → u32
    mul: u32 u32 → u32
    div: u32 u32 → u32
    mod: u32 u32 → u32
    neg: u32 → u32
    eq: u32 u32 → bool
    lt: u32 u32 → bool
    le: u32 u32 → bool
    to_f32: u32 → f32
    dup: u32 → u32 u32
    drop: u32 → C
    swap: u32 u32 → u32 u32
}

[style.color[hue[0.05]]]
f32x2: C → C with {
    pack: f32 f32 → f32x2
    unpack: f32x2 → f32 f32
    add: f32x2 f32x2 → f32x2
    sub: f32x2 f32x2 → f32x2
    mul: f32x2 f32x2 → f32x2
    div: f32x2 f32x2 → f32x2
    neg: f32x2 → f32x2
    scale: f32 f32x2 → f32x2
    dup: f32x2 → f32x2 f32x2
    drop: f32x2 → C
    swap: f32x2 f32x2 → f32x2 f32x2
}

[style.color[hue[0.95]]]
f32x3: C → C with {
    pack: f32 f32 f32 → f32x3
    unpack: f32x3 → f32 f32 f32
    add: f32x3 f32x3 → f32x3
    sub: f32x3 f32x3 → f32x3
    mul: f32x3 f32x3 → f32x3
    div: f32x3 f32x3 → f32x3
    neg: f32x3 → f32x3
    scale: f32 f32x3 → f32x3
    dup: f32x3 → f32x3 f32x3
    drop: f32x3 → C
    swap: f32x3 f32x3 → f32x3 f32x3
}
